class Solution {
    public int maxSubarraySum(int[] arr, int k) {
       int low=0;
       int high=k-1;
       int sum=0;
       
       int n=arr.length;
       
       for (int i=0;i<=high;i++){
           sum=sum+arr[i];
           
       }
       int result=sum;
       
        while (high<n){
           result=Math.max(result,sum);
            sum=sum-arr[low];
           low++;
           high++;
           
           if(high==n){
               break;
           }
           
          
           sum=sum+arr[high];
       }
       return result;
       
        
    }
}
