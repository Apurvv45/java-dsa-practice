import java.util.*;

class Solution {
    public int[] sortedSquares(int[] nums) {

        List<Integer> neg = new ArrayList<>();
        List<Integer> pos = new ArrayList<>();

        
        for (int num : nums) {
            if (num < 0)
                neg.add(num * num);
            else
                pos.add(num * num);
        }

      
        Collections.reverse(neg);

        int n1 = neg.size();
        int n2 = pos.size();

        int[] res = new int[n1 + n2];

        int i = 0, j = 0, index = 0;

        while (i < n1 && j < n2) {

            if (neg.get(i) <= pos.get(j)) {
                res[index++] = neg.get(i++);
            } else {
                res[index++] = pos.get(j++);
            }
        }

        while (i < n1) {
            res[index++] = neg.get(i++);
        }

        while (j < n2) {
            res[index++] = pos.get(j++);
        }

        return res;
    }
}
