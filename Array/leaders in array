import java.util.Arrays;

class Solution {
    public int[] superiorElements(int[] a) {
        int n = a.length;
        int maxi = Integer.MIN_VALUE;
        int count = 0;

        
        for (int i = n - 1; i >= 0; i--) {
            if (a[i] > maxi) {
                count++;
                maxi = a[i];
            }
        }

        
        int[] ans = new int[count];

        
        maxi = Integer.MIN_VALUE;
        int index = count - 1;

        for (int i = n - 1; i >= 0; i--) {
            if (a[i] > maxi) {
                ans[index] = a[i];
                index--;
                maxi = a[i];
            }
        }

        return ans;
    }
}
