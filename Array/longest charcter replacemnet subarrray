class Solution {
    public int characterReplacement(String s, int k) {
        int n=s.length();
        int low=0;
        int high=0;
        int res=0;
        int maxf=0;

        int[] freq=new int[26];

        for(high=0;high<n;high++){
            char ch=s.charAt(high);
            freq[ch-'A']++;
            maxf=Math.max(maxf,freq[ch-'A']);

            while((high-low+1)-maxf>k){
                freq[s.charAt(low)-'A']--;
                low++;
            }
            res=Math.max((high-low+1),res);
        }
        
        return res;
    }
}
