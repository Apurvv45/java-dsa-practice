class Solution {
    public int maxSubArray(int[] nums) {
        int n = nums.length;
        int ans=nums[0];
        int best=nums[0];

        for(int i=1;i<n;i++){
            int v1=ans+nums[i];
            int v2=nums[i];

            ans=Math.max(v1,v2);
            best=Math.max(best,ans);
        }
        return best;
    }
}
